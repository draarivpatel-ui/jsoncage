{
  "name": "jsoncage",
  "version": "1.0.0",
  "description": "Zero-dependency strict RFC 8259 and I-JSON security parser with duplicate-key, prototype-pollution, and JSON denial-of-service defenses",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draarivpatel-ui/jsoncage.git"
  },
  "homepage": "https://github.com/draarivpatel-ui/jsoncage#readme",
  "bugs": {
    "url": "https://github.com/draarivpatel-ui/jsoncage/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "jsoncage": "bin/jsoncage.mjs"
  },
  "files": [
    "src",
    "dist",
    "types",
    "bin",
    "docs",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build:cjs": "node scripts/build-cjs.mjs",
    "check:cjs": "node scripts/build-cjs.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "security",
    "json",
    "json-parser",
    "rfc8259",
    "i-json",
    "rfc7493",
    "json-pointer",
    "rfc6901",
    "json-merge-patch",
    "rfc7396",
    "canonical-json",
    "prototype-pollution",
    "duplicate-keys",
    "denial-of-service",
    "node",
    "zero-dependency"
  ],
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {},
  "devDependencies": {}
}
